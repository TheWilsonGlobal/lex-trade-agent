# LLM Endpoint Configuration
# Supports local Vulkan/llama-server (Hermes 3 GGUF), vLLM, Ollama, or OpenRouter/OpenAI
LLM_API_URL=http://127.0.0.1:5813/v1
LLM_API_KEY=local-dev-key
LLM_MODEL=LFM-2.5-2.6B-Instruct-Q8_0

# Alternative standard OpenAI environment variable names
OPENAI_BASE_URL=http://127.0.0.1:5813/v1
OPENAI_API_KEY=local-dev-key
OPENAI_MODEL=LFM-2.5-2.6B-Instruct-Q8_0

# Execution Mode (set to 'false' to route live inference to local model)
FORCE_MOCK_LLM=false

# SQLite Database Location
SQLITE_DB_PATH=lex_trade_memory.db
